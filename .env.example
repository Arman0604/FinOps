# FinOps Platform — Environment Variables
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────
# Phase 5: AI Chatbot (Groq)
# Get your key at: https://console.groq.com/keys
# ─────────────────────────────────────────────
GROQ_API_KEY=your_api_key_here

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=mixtral-8x7b-32768

# ─────────────────────────────────────────────
# API Server (optional overrides)
# ─────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000

# JWT authentication
# Generate a long random value for production, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
# JWT_TTL_MINUTES=120
